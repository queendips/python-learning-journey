class CreditCard:

    def pay(self):
        print("Payment using Credit Card")

class UPI:

    def pay(self):
        print("Payment using UPI")

class Cash:

    def pay(self):
        print("Payment using Cash")

def make_payment(method):
    method.pay()

make_payment(CreditCard())
make_payment(UPI())
make_payment(Cash())